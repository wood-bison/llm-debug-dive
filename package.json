{
  "name": "llm-debug-dive",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "bun install && docker compose up -d postgres && bun run build",
    "dev": "bun run --watch src/proxy.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "bun build src/proxy.ts --target=bun --outfile=dist/proxy.js",
    "start": "bun run dist/proxy.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "verify": "bash scripts/verify.sh",
    "demo:seed": "bun run scripts/seed-demo.ts",
    "view": "bun run src/view.ts",
    "lint": "eslint src web/src scripts test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
